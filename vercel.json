{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/blob-upload-token.ts": {
      "maxDuration": 30
    },
    "api/ftps-transfer.ts": {
      "maxDuration": 60
    },
    "api/send-protocol-email.ts": {
      "maxDuration": 60
    },
    "api/cleanup-expired-blobs.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cleanup-expired-blobs",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
